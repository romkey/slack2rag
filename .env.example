# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# ── Docker Compose (optional; not read by the app) ───────────────────────────
# Release to run with docker-compose.prod.yaml; default latest.
# APP_VERSION=0.7.0

# ── Slack ─────────────────────────────────────────────────────────────────────
# Bot token (xoxb-) from https://api.slack.com/apps. Scopes: channels:read
# channels:history pins:read bookmarks:read users:read. Never grant
# channels:join, any groups:/im:/mpim: scope, or use a user token.
SLACK_BOT_TOKEN=xoxb-your-token-here

# App-level token (xapp-) with connections:write, for live events over
# Socket Mode. Empty: no live events; the hourly catch-up still finds new
# messages, edits and deletions (deletions may then take up to an hour).
# SLACK_APP_TOKEN=xapp-1-your-token-here

# The bot reads only channels it has been invited to. These are never read
# even if someone invites it: comma-separated names (with or without #) or
# IDs.
# SLACK_CHANNEL_DENYLIST=board,membership

# Other bots and integrations are ignored unless listed here, by bot ID,
# username or bot name (for example an announcements integration).
# SLACK_BOT_ALLOWLIST=announcer

# Seconds between Slack API calls. 1.2 stays under the free plan's limit.
SLACK_API_PAUSE=1.2

# ── PostgreSQL (required) ─────────────────────────────────────────────────────
# Staging: units, facts, quarantine, cursors and sync status. No raw message
# text, user IDs or names are stored. The schema is created and upgraded
# automatically on start. With
# docker-compose.prod.yaml the host is "db".
DATABASE_URL=postgresql://slack2rag:change-me@db:5432/slack2rag

# Used by the db service in docker-compose.prod.yaml; match DATABASE_URL.
# POSTGRES_USER=slack2rag
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=slack2rag

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Overridden to http://qdrant:6333 inside docker-compose; set for external use.
QDRANT_URL=http://localhost:6333
# The member-tier collection. Everything from Slack is member tier, so
# hs_public is refused.
QDRANT_COLLECTION=hs_member

# ── Model gateway (OpenAI API) ────────────────────────────────────────────────
# Embeddings: POST {LLM_BASE_URL}/embeddings. By default a local Hugging Face
# Text Embeddings Inference (TEI) server, which the compose files run as the
# "embeddings" service. Any OpenAI-compatible gateway works.
# LLM_BASE_URL=http://localhost:8080/v1

# The compose files ignore LLM_BASE_URL and use this instead, defaulting to
# their bundled embeddings service.
# CONTAINER_LLM_BASE_URL=http://embeddings/v1

# TEI image tag for the bundled embeddings service; cpu-arm64-1.9.4 on ARM.
# TEI_IMAGE_TAG=cpu-1.9.4

# Optional Bearer token for the gateway.
LLM_API_KEY=

# ── Embedding model ───────────────────────────────────────────────────────────
# The model's name on the gateway, and the prompts it was trained with:
#
#   Model (dims, context)                        Query prefix       Document prefix
#   nomic-ai/modernbert-embed-base (768, 8192)   "search_query: "   "search_document: "   <- default
#   Alibaba-NLP/gte-modernbert-base (768, 8192)  ""                 ""
#   intfloat/e5-*-v2, multilingual-e5-* (512)    "query: "          "passage: "
#   Qwen/Qwen3-Embedding-0.6B (1024, 32768)      an instruction line  ""
#
# The model and dimension are recorded in the collection; changing the model
# or the document prefix needs the collection deleted and a re-index from
# staging (`slack2rag reprocess`).
EMBEDDING_MODEL=nomic-ai/modernbert-embed-base
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_CONTEXT_LENGTH=2048
# Compose files only: the embeddings service's own input limit in tokens.
# TEI_MAX_BATCH_TOKENS=2048

# Facts embedded per request.
BATCH_SIZE=50

# ── Chat model (required) ─────────────────────────────────────────────────────
# Runs the relevance check, fact extraction and exclusion check. Choose it
# by running candidates against the labeled units (`slack2rag
# eval-classifier`), not by reputation. Check exact tags with your server.
CHAT_MODEL=qwen3.5:9b

# A separate OpenAI-compatible endpoint and key for the chat model; unset,
# they are LLM_BASE_URL and LLM_API_KEY. TEI has no chat models, so with the
# bundled embeddings this points at Ollama, vLLM or another gateway.
# CHAT_BASE_URL=http://ollama:11434/v1
# CHAT_API_KEY=

# The shared topic taxonomy: one slug per line. Facts are tagged with up to
# three of them. Empty: no topics.
# TOPICS_FILE=/data/topics.txt

# ── Conversation units ────────────────────────────────────────────────────────
# Unthreaded messages less than this many minutes apart form one session.
SESSION_GAP_MINUTES=30
# Longest session, in messages; and how many messages a session borrows
# from the one before it so a question and its answer stay together.
SESSION_MAX_MESSAGES=40
SESSION_OVERLAP_MESSAGES=2
# Hours a unit must be quiet before it is processed, so late answers count.
QUIET_HOURS=3

# ── Sync ──────────────────────────────────────────────────────────────────────
# Minutes between catch-up runs.
SYNC_INTERVAL_MINUTES=60
# How far back each catch-up rereads history, for late edits and deletions.
CATCHUP_LOOKBACK_HOURS=72
# Days of history the first run reads; 0 reads all Slack returns (the free
# plan keeps 90 days).
BACKFILL_DAYS=0
# UTC hour of the nightly full reconcile.
RECONCILE_HOUR=3
# Day of the weekly wiki promotion report (0 = Monday), and where it goes.
REPORT_WEEKDAY=0
REPORT_DIR=/data/reports
# How similar (0-1) a newer fact about the same things must be to supersede
# an older one.
SUPERSEDE_SIMILARITY=0.9
# true runs one catch-up and exits.
RUN_ONCE=false

# ── Search ────────────────────────────────────────────────────────────────────
# Minimum fused score for `slack2rag query`; 0 disables.
SCORE_THRESHOLD=0.0

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# ── Publishing to PyPI (optional; not read by the app) ────────────────────────
# Only for publishing by hand (`uv publish`); releases from GitHub use
# trusted publishing. Keep it out of .env on servers: compose passes .env to
# the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
