# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# ── Docker Compose (optional; not read by the app) ───────────────────────────
# Release to run with docker-compose.prod.yaml; default latest.
# APP_VERSION=0.5.0
# Set to postgres to start the optional PostgreSQL services.
# COMPOSE_PROFILES=postgres

# ── Required ──────────────────────────────────────────────────────────────────
# Bot token from https://api.slack.com/apps — needs scopes:
#   channels:read  channels:history  channels:join  users:read
SLACK_BOT_TOKEN=xoxb-your-token-here

# ── Slack ─────────────────────────────────────────────────────────────────────
# Comma-separated channel names or IDs to index.
# Leave empty to index ALL public channels visible to the bot.
SLACK_CHANNELS=

# Comma-separated channel names or IDs to skip entirely.
# These channels will not be indexed or evaluated.
# SLACK_CHANNEL_BLACKLIST=random,social,off-topic

# ── PostgreSQL (optional) ─────────────────────────────────────────────────────
# When set, every Slack channel, user, and raw message payload is upserted here.
# Run `slack2rag migrate` to create or upgrade the schema first (the
# production compose file's migrate service does it for you).
# With docker-compose.prod.yaml's postgres profile the host is "db":
# DATABASE_URL=postgresql://slack2rag:change-me@db:5432/slack2rag
DATABASE_URL=

# Used by the db service in docker-compose.prod.yaml; match DATABASE_URL.
# POSTGRES_USER=slack2rag
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=slack2rag

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Overridden to http://qdrant:6333 inside docker-compose; set for external use.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=slack_messages

# ── Embedding server (OpenAI API) ─────────────────────────────────────────────
# slack2rag talks to the embedding server over the OpenAI API (POST
# {base}/embeddings; the evaluator uses {base}/chat/completions). By default
# that is a local Hugging Face Text Embeddings Inference (TEI) server, which
# the compose files run as the "embeddings" service. Any OpenAI-compatible
# server works:
#   TEI:           http://localhost:8080/v1    (default; the dev compose file
#                                               publishes it on port 8080)
#   OpenAI:        https://api.openai.com/v1
#   Ollama:        http://localhost:11434/v1
#   vLLM:          http://localhost:8000/v1
#   LM Studio:     http://localhost:1234/v1
# For a pip install; unset, it is http://localhost:8080/v1.
# LLM_BASE_URL=http://localhost:8080/v1

# The compose files ignore LLM_BASE_URL and use this instead, defaulting to
# their bundled embeddings service. Set it to use another server from the
# container: OpenAI (https://api.openai.com/v1), the optional bundled Ollama
# (http://ollama:11434/v1, with COMPOSE_PROFILES=ollama) or a server on the
# host (http://host.docker.internal:8080/v1).
# CONTAINER_LLM_BASE_URL=http://embeddings/v1

# TEI image tag for the bundled embeddings service. The default is for
# x86-64; on ARM hosts (Apple silicon, Graviton) use cpu-arm64-1.9.4. With an
# NVIDIA GPU, see TEI's docs for the matching tag (e.g. 89-1.9.4).
# TEI_IMAGE_TAG=cpu-1.9.4

# Optional API key, sent as a Bearer token in the Authorization header.
# Required for OpenAI; leave empty for local servers.
LLM_API_KEY=

# ── Embedding model and prompts ───────────────────────────────────────────────
# The model's name on the server. The bundled TEI service also downloads and
# serves whatever this names from Hugging Face, so it must be a Hugging Face
# model id when you use it.
#
# Many embedding models are trained with a short prompt in front of each
# text, one for search queries and another for the documents being
# searched. Using a model without its prompts noticeably hurts retrieval, so
# set the two prefixes below to match the model:
#
#   Model (dims, context)                        Query prefix       Document prefix
#   nomic-ai/modernbert-embed-base (768, 8192)   "search_query: "   "search_document: "   <- default
#   Alibaba-NLP/gte-modernbert-base (768, 8192)  ""                 ""
#   nomic-ai/nomic-embed-text-v1.5 (768, 8192)   "search_query: "   "search_document: "
#     (Ollama: nomic-embed-text)
#   intfloat/e5-*-v2, multilingual-e5-* (512)    "query: "          "passage: "
#   mixedbread-ai/mxbai-embed-large-v1           "Represent this sentence for searching relevant passages: "
#     (1024, 512; Ollama: mxbai-embed-large)                        ""
#   Qwen/Qwen3-Embedding-0.6B (1024, 32768)      an instruction line, e.g.
#     "Instruct: Given a question, retrieve Slack messages that answer it\nQuery:"
#                                                                   ""
#   OpenAI text-embedding-3-small (1536, 8191)   ""                 ""
#   OpenAI text-embedding-3-large (3072, 8191)   ""                 ""
#
# Put a prefix in double quotes so its trailing space survives; "\n" in
# double quotes is a newline. Set a prefix to "" for models that take none.
#
# Changing the model or the document prefix changes every stored vector:
# delete the Qdrant collection (and STATE_FILE) and re-index. The query
# prefix only affects searches. Any other app that queries the Qdrant
# collection directly must add the same query prefix to its queries.
EMBEDDING_MODEL=nomic-ai/modernbert-embed-base
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
# EMBEDDING_PREFIX was replaced by the two settings above; setting it is
# an error.

# Longest embedding input, in tokens, prefix included; longer texts are
# truncated at a word boundary before embedding. At most the model's context
# (see the table above). The compose files' embeddings service uses it as its
# own limit too: ModernBERT accepts 8192, but on CPU anything past about
# 2048 needs several GB of memory, so 2048 is the default. Most Slack
# messages and threads are far shorter. 0 disables truncation (not with the
# bundled service).
EMBEDDING_CONTEXT_LENGTH=2048

# ── Retrieval quality ─────────────────────────────────────────────────────────

# Minimum cosine similarity score (0.0–1.0) for search results.
# Results below this threshold are discarded, letting the chatbot say
# "I don't know" instead of hallucinating from weak matches.
# 0.0 disables the threshold.
SCORE_THRESHOLD=0.0

# Enable hybrid search: stores sparse (BM25-like) vectors alongside
# dense embeddings and fuses them with Reciprocal Rank Fusion.
# Catches keyword/exact-match queries that pure semantic search misses.
# NOTE: Enabling requires deleting the Qdrant collection and re-indexing.
HYBRID_SEARCH=false

# ── Reaction boost ─────────────────────────────────────────────────────

# Messages with at least this many emoji reactions get "[highlighted by
# team]" prepended before embedding, making community-curated content
# cluster together in vector space and rank higher.  0 disables the boost.
REACTION_BOOST_THRESHOLD=3

# ── Message filtering ─────────────────────────────────────────────────────────

# Minimum character length for standalone messages (no replies) to be
# indexed.  Shorter messages ("ok", "thanks", "+1") are skipped.
# Threads are always indexed regardless of length.  0 disables filtering.
MIN_MESSAGE_LENGTH=20

# ── Thread updates ────────────────────────────────────────────────────────────

# Hours to look back for threads that gained new replies since they
# were last indexed.  This refresh pass runs after each incremental
# sync.  0 disables thread refresh.  24–72 is a good starting value.
THREAD_UPDATE_LOOKBACK_HOURS=0

# ── Sync ──────────────────────────────────────────────────────────────────────
# Minutes between syncs (only relevant when not running one-shot).
SYNC_INTERVAL_MINUTES=60

# Set to "true" to run once and exit (useful for cron / k8s jobs).
RUN_ONCE=false

# Where the per-channel sync cursors are kept; channel_stats.json goes next
# to it. The Docker image keeps it in the /data volume.
STATE_FILE=/data/state.json

# How many messages to embed per batch (tune for memory vs. speed).
BATCH_SIZE=50

# Seconds to pause between Slack API calls.  1.2 s keeps well under
# the free-plan rate limit (~50 req/min).  Set to 0 for paid plans.
SLACK_API_PAUSE=1.2

# ── Eval mode ─────────────────────────────────────────────────────────────────
# Set EVAL_TEST=true to enable eval mode.  In eval mode the
# program scans ALL Slack messages, sends each one to a chat-completions
# LLM with EVAL_PROMPT, and writes scored results to /results/good.txt
# (score >= 7) and /results/bad.txt (score < 7).  No indexing or Qdrant
# work is done.
#
# EVAL_TEST=true
# EVAL_MODEL=llama3
# EVAL_PROMPT=Rate how likely this Slack message is an explanation or resource recommendation on a scale of 1-10
#
# Optional: point the evaluator at a different OpenAI-compatible endpoint
# (e.g. local embeddings + cloud LLM for scoring).  When unset, the
# evaluator reuses LLM_BASE_URL and LLM_API_KEY.
# EVAL_BASE_URL=https://api.openai.com/v1
# EVAL_API_KEY=sk-REPLACE_ME

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# ── Publishing to PyPI (optional; not read by the app) ────────────────────────
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
